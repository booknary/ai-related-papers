{
  "name": "ai-related-papers",
  "type": "module",
  "version": "0.1.1",
  "description": "A Zotero plugin for finding, reviewing, linking, visualizing, and AI-tagging related papers.",
  "config": {
    "addonName": "AI Related Papers",
    "addonID": "ai-related-papers@booknary.github.io",
    "addonRef": "airelatedpapers",
    "addonInstance": "AIRelatedPapers",
    "prefsPrefix": "extensions.zotero.airelatedpapers"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/booknary/ai-related-papers.git"
  },
  "author": "booknary",
  "bugs": {
    "url": "https://github.com/booknary/ai-related-papers/issues"
  },
  "homepage": "https://github.com/booknary/ai-related-papers#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
